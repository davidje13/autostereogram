{
	"name": "autostereogram",
	"version": "0.0.0",
	"private": true,
	"author": "David Evans",
	"license": "GPL-3.0",
	"scripts": {
		"format": "prettier --write .",
		"start": "web-listener -c web/config.json --dir build/static --exec 'rollup --config rollup.config.mjs --watch' --no-cache",
		"build": "./web/build.sh && rollup --config rollup.config.mjs && cd build && zip -8Xr -n .png - * > ../web-bundle.zip"
	},
	"dependencies": {
		"curve-ops": "0.2.0"
	},
	"devDependencies": {
		"@rollup/plugin-node-resolve": "16.x",
		"prettier": "3.9.6",
		"rollup": "4.x",
		"web-listener": "1.5.x"
	}
}
